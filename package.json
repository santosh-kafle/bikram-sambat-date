{
  "name": "bikram-sambat-date",
  "version": "0.1.0",
  "description": "Accurate, time-zone-safe Bikram Sambat (BS) ↔ Gregorian (AD) date conversion for Node.js backends, with a cross-checked calendar table.",
  "keywords": [
    "bikram-sambat",
    "nepali-date",
    "nepali-calendar",
    "bs-to-ad",
    "ad-to-bs",
    "date-converter",
    "nepal",
    "typescript"
  ],
  "license": "MIT",
  "author": "Santosh Kafle <santoshkafle.dev@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "data:build": "tsx scripts/build-calendar.ts",
    "data:calibrate": "tsx scripts/calibrate.ts",
    "data:fetch-hamropatro": "tsx scripts/fetch-hamropatro.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=America/New_York vitest run && TZ=Asia/Kathmandu vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
