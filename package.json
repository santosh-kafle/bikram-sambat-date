{
  "name": "bikram-sambat-date",
  "version": "0.1.0",
  "description": "Accurate, time-zone-safe Bikram Sambat (BS) ↔ Gregorian (AD) date conversion for Node.js backends, with a cross-checked calendar table.",
  "keywords": [
    "bikram-sambat",
    "nepali-date",
    "nepali-calendar",
    "bs-to-ad",
    "ad-to-bs",
    "date-converter",
    "fiscal-year",
    "devanagari",
    "nepal",
    "nestjs",
    "typescript"
  ],
  "homepage": "https://github.com/santosh-kafle/bikram-sambat-date#readme",
  "bugs": {
    "url": "https://github.com/santosh-kafle/bikram-sambat-date/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santosh-kafle/bikram-sambat-date.git"
  },
  "license": "MIT",
  "author": "Santosh Kafle <santoshkafle.dev@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/nestjs/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "data:build": "tsx scripts/build-calendar.ts",
    "data:calibrate": "tsx scripts/calibrate.ts",
    "data:fetch-hamropatro": "tsx scripts/fetch-hamropatro.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=UTC vitest run && TZ=America/New_York vitest run && TZ=Asia/Kathmandu vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run data:check && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "data:check": "tsx scripts/build-calendar.ts --check && tsx scripts/calibrate.ts --check",
    "check:package": "publint && attw --pack ."
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^11.2.7",
    "@types/node": "^22.20.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
